{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Small-model public speech input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "game_id",
    "event_id",
    "speaker_id",
    "public_text"
  ],
  "properties": {
    "game_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "speaker_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "public_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    }
  }
}